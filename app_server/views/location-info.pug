extends layout
include _includes/sharedHTMLfunctions
block content
  .row.banner
    .col-12
      h1= pageHeader.title
  .row
    .col-12.col-lg-9
      .row
        .col-12.col-md-6
          p.rating
            +outputRating(location.rating)
          p= location.address
          .card.card-primary
            .card-body.p-0
              h2.card-title Opening hours
              each time in location.openingTimes
                p.card-text
                  | #{time.days}&nbsp;:&nbsp;
                  span.float-end
                    if time.closed
                      | closed
                    else
                      | #{time.opening} - #{time.closing}
          .card.card-primary
            .card-body.p-0
              h2.card-title Facilities
              each facility in location.facilities
                span.badge.bg-warning
                  i.fa.fa-check
                  | &nbsp;#{facility}
                | &nbsp;
        .col-12.col-md-6.location-map
          .card.card-primary
            .card-body.p-0
              h2.mb-3.card-title Location map
              img.img-fluid.rounded(src=`https://maps.googleapis.com/maps/api/staticmap?center=${location.coords.lat},${location.coords.lng}&zoom=17&size=400x350&sensor=false&markers=37.468769,126.964062&scale=2&key=${process.env.GOOGLE_API_KEY}`)
      .row
        .col-12
          .card.card-primary.pb-0.mt-2.review-card
            .card-body.p-0
              a.btn.btn-primary.float-end(href='/location/' + location._id + '/review') Add review
              h2.mb-3.card-title Customer reviews
              each review in location.reviews
                .row.review
                  .col-12.review-header
                    span.rating
                      +outputRating(review.rating)
                    span.reviewAuthor #{review.author}
                    small.reviewTimestamp.float-end
                      +formatDate(review.createdOn)
                  .col-12
                    p !{(review.reviewText).replace(/\n/g, '<br/>')}
    .col-12.col-lg-3
      p.lead #{location.name} #{sidebar.context}
      p= sidebar.callToAction
